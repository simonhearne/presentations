   "value": 0,
   "on": [
    {
     "events": {
      "type": "timer",
      "throttle": 16
     },
     "update": "stage < 1 ? 0 : stage < 2 ? min(5.332, draw + 0.0178) : stage < 3 ? min(7.702, max(draw, 5.332) + 0.0152) : min(13, max(draw, 7.702) + 0.0282)"
    }
   ]
  }
 ],
