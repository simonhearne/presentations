{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "WS2 1M-scale refine ablation: recall@10 vs nprobe by rerank k. Source: data/ws2/curves_1m.csv, columns sweep_value and recall_at_10.",
  "data": { "url": "../data/ws2/curves_1m.csv" },
  "width": 1500,
  "height": 550,
  "params": [{ "name": "stage", "value": 0 }],
  "transform": [
    { "filter": { "field": "arm", "oneOf": ["rabitq", "rabitq_refine_sq8_k1", "rabitq_refine_sq8_k2", "rabitq_refine_sq8_k5", "rabitq_refine_sq8_k10"] } },
    { "filter": "datum.sweep_param === 'nprobe'" },
    {
      "calculate": "{'rabitq':0,'rabitq_refine_sq8_k1':1,'rabitq_refine_sq8_k2':2,'rabitq_refine_sq8_k5':3,'rabitq_refine_sq8_k10':4}[datum.arm]",
      "as": "armStage"
    }
  ],
  "mark": { "type": "line", "point": { "size": 50, "filled": true }, "strokeWidth": 2.5 },
  "encoding": {
    "x": {
      "field": "sweep_value", "type": "quantitative",
      "scale": { "type": "log", "domain": [1, 300] },
      "axis": { "title": "nprobe (log scale)" }
    },
    "y": {
      "field": "recall_at_10", "type": "quantitative",
      "scale": { "domain": [0.4, 1.0] },
      "axis": { "title": "recall@10", "format": ".2f" }
    },
    "color": {
      "field": "arm", "type": "nominal",
      "scale": { "domain": ["rabitq", "rabitq_refine_sq8_k1", "rabitq_refine_sq8_k2", "rabitq_refine_sq8_k5", "rabitq_refine_sq8_k10"] },
      "legend": { "title": "Variant", "orient": "bottom-right", "labelLimit": 300 }
    },
    "opacity": {
      "condition": { "test": "datum.armStage <= stage", "value": 1 },
      "value": 0
    },
    "tooltip": [
      { "field": "arm" },
      { "field": "sweep_value", "title": "nprobe" },
      { "field": "recall_at_10", "format": ".3f" }
    ]
  }
}