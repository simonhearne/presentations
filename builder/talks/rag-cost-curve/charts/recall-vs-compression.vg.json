    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "width"
          },
          "y": {
            "scale": "yscale",
            "value": 1
          },
          "dx": {
            "value": -4
          },
          "dy": {
            "value": -12
          },
          "align": {
            "value": "right"
          },
          "fill": {
            "value": "#475569"
          }
        },
        "update": {
          "opacity": {
            "value": 1
          },
          "text": {
            "signal": "'1x = the measured IVF_FLAT fp32 index, recall 1.0 = exhaustive search'"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "baseline_points"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xscale",
            "field": "footprint_compression"
          },
          "y": {
            "scale": "yscale",
            "field": "recall_max"
          },
          "size": {
            "value": 900
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "scale": "family",
            "field": "family"
          },
          "strokeWidth": {
            "value": 3
          },
          "tooltip": {
            "signal": "{'arm': datum.arm, 'recall@10': format(datum.recall_max, '.3f'), 'loaded': format(datum.loaded_bytes / 1e9, '.2f') + ' GB', 'footprint compression': format(datum.footprint_compression, '.2f') + 'x'}"
          },
          "strokeDash": {
            "signal": "datum.arm === 'hnsw_fp32' ? [5, 4] : [1, 0]"
          }
        },
        "update": {
          "x": {
            "scale": "xscale",
            "field": "footprint_compression"
          },
          "y": {
            "scale": "yscale",
            "field": "recall_max"
          },
          "size": {
            "value": 900
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "scale": "family",
            "field": "family"
          },
          "strokeWidth": {
            "value": 3
          },
          "tooltip": {
            "signal": "{'arm': datum.arm, 'recall@10': format(datum.recall_max, '.3f'), 'loaded': format(datum.loaded_bytes / 1e9, '.2f') + ' GB', 'footprint compression': format(datum.footprint_compression, '.2f') + 'x'}"
          },
          "opacity": {
            "value": 1
          },
          "strokeDash": {
            "signal": "datum.arm === 'hnsw_fp32' ? [5, 4] : [1, 0]"
          }
        }
      },
      "name": "baseline_markers"
    },
    {
