{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "ANN vs exact search: comparisons required per query as the vector count grows. The right axis estimates query latency as `overheadMs` of fixed overhead plus `nsPerCmp` per comparison: 768-d float32 vectors (~3 KB read per comparison) on a mid-range server CPU with ~60 GB/s of memory bandwidth, so ~50 ns each. Stepped reveal via the `stage` signal; each line sweeps left-to-right as its stage is entered.",
  "width": 1200,
  "height": 600,
  "signals": [
    {"name": "stage", "value": 0},
    {"name": "span", "value": 7},
    {"name": "overheadMs", "value": 4},
    {"name": "nsPerCmp", "value": 50},
    {"name": "exactMs", "update": "overheadMs + 1e9 * nsPerCmp / 1e6"},
    {"name": "annMs", "update": "overheadMs + 5350 * nsPerCmp / 1e6"},
    {
      "name": "drawExact",
      "value": 0,
      "on": [
        {
          "events": {"type": "timer", "throttle": 30},
          "update": "stage >= 1 ? min(drawExact + 0.2, span) : 0"
        }
      ]
    },
    {
      "name": "drawAnn",
      "value": 0,
      "on": [
        {
          "events": {"type": "timer", "throttle": 30},
          "update": "stage >= 2 ? min(drawAnn + 0.2, span) : 0"
        }
      ]
    }
  ],
"data": [
    {
      "name": "raw",
      "transform": [
        {"type": "sequence", "start": 2, "stop": 9.0001, "step": 0.125, "as": "e"}
      ]
    },
    {
      "name": "exactLine",
      "source": "raw",
      "transform": [
        {"type": "filter", "expr": "datum.e <= 2 + drawExact"},
        {"type": "formula", "expr": "pow(10, datum.e)", "as": "n"},
        {"type": "formula", "expr": "datum.n", "as": "comparisons"}
      ]
    },
    {
      "name": "annLine",
      "source": "raw",
      "transform": [
        {"type": "filter", "expr": "datum.e <= 2 + drawAnn"},
        {"type": "formula", "expr": "pow(10, datum.e)", "as": "n"},
        {"type": "formula", "expr": "min(datum.n, 4000 + 150 * datum.e)", "as": "comparisons"}
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "log",
      "base": 10,
      "domain": [80, 2000000000],
      "range": "width",
      "nice": false,
      "clamp": true
    },
    {
      "name": "y",
      "type": "log",
      "base": 10,
      "domain": [80, 2000000000],
      "range": "height",
      "nice": false,
      "clamp": true
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "title": "embeddings",
      "values": [100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000],
      "format": "~s"
    },
    {
      "orient": "left",
      "scale": "y",
      "title": "comparisons / query",
      "values": [100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000],
      "format": "~s"
    },
    {
      "orient": "right",
      "scale": "y",
      "title": "est. latency / query",
      "values": {"signal": "[100, (5 - overheadMs) * 1e6 / nsPerCmp, (10 - overheadMs) * 1e6 / nsPerCmp, (100 - overheadMs) * 1e6 / nsPerCmp, (1000 - overheadMs) * 1e6 / nsPerCmp, (10000 - overheadMs) * 1e6 / nsPerCmp, (60000 - overheadMs) * 1e6 / nsPerCmp]"},
      "domain": false,
      "ticks": false,
      "encode": {
        "labels": {
          "update": {
            "text": {"signal": "(overheadMs + datum.value * nsPerCmp / 1e6) < 1000 ? format(overheadMs + datum.value * nsPerCmp / 1e6, '.0f') + ' ms' : (overheadMs + datum.value * nsPerCmp / 1e6) < 60000 ? format((overheadMs + datum.value * nsPerCmp / 1e6) / 1000, '.0f') + ' s' : format((overheadMs + datum.value * nsPerCmp / 1e6) / 60000, '.0f') + ' min'"}
          }
        }
      }
    }
  ],
  "marks": [
    {
      "type": "line",
      "from": {"data": "exactLine"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "n"},
          "y": {"scale": "y", "field": "comparisons"},
          "stroke": {"value": "#175fff"},
          "strokeWidth": {"value": 4},
          "strokeCap": {"value": "round"},
          "interpolate": {"value": "monotone"}
        },
        "update": {
          "opacity": {"signal": "stage >= 1 ? 1 : 0"}
        }
      }
    },
    {
      "type": "line",
      "from": {"data": "annLine"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "n"},
          "y": {"scale": "y", "field": "comparisons"},
          "stroke": {"value": "#d97706"},
          "strokeWidth": {"value": 4},
          "strokeCap": {"value": "round"},
          "interpolate": {"value": "monotone"}
        },
        "update": {
          "opacity": {"signal": "stage >= 2 ? 1 : 0"}
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 1000000000},
          "y": {"scale": "y", "value": 1000000000},
          "size": {"value": 130},
          "fill": {"value": "#175fff"},
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 2}
        },
        "update": {
          "opacity": {"signal": "drawExact >= span ? 1 : 0"}
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 1000000000},
          "y": {"scale": "y", "value": 5350},
          "size": {"value": 130},
          "fill": {"value": "#d97706"},
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 2}
        },
        "update": {
          "opacity": {"signal": "drawAnn >= span ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 1000000000, "offset": -26},
          "y": {"scale": "y", "value": 1000000000},
          "align": {"value": "right"},
          "baseline": {"value": "middle"},
          "fill": {"value": "#175fff"},
          "fontWeight": {"value": 700}
        },
        "update": {
          "text": {"signal": "'Exact: 1Bn in ~' + format(exactMs / 1000, '.0f') + ' s'"},
          "opacity": {"signal": "drawExact >= span ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 1000000000, "offset": 8},
          "y": {"scale": "y", "value": 5350, "offset": 16},
          "align": {"value": "right"},
          "baseline": {"value": "top"},
          "fill": {"value": "#b45309"},
          "fontWeight": {"value": 700}
        },
        "update": {
          "text": {"signal": "'ANN: 1Bn in ~' + format(annMs, '.1f') + ' ms'"},
          "opacity": {"signal": "drawAnn >= span ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 300000},
          "y": {"scale": "y", "value": 300000},
          "dy": {"value": -10},
          "angle": {"value": -26},
          "align": {"value": "center"},
          "baseline": {"value": "bottom"},
          "text": {"value": "Exact search"},
          "fill": {"value": "#175fff"},
          "fontWeight": {"value": 600}
        },
        "update": {
          "opacity": {"signal": "drawExact >= span ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 1000000},
          "y": {"scale": "y", "value": 6000},
          "align": {"value": "center"},
          "baseline": {"value": "bottom"},
          "text": {"value": "ANN search"},
          "fill": {"value": "#b45309"},
          "fontWeight": {"value": 600}
        },
        "update": {
          "opacity": {"signal": "drawAnn >= span ? 1 : 0"}
        }
      }
    },
    {
      "type": "rule",
      "style": "guide",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 1000000000},
          "y": {"scale": "y", "value": 5350},
          "y2": {"scale": "y", "value": 1000000000}
        },
        "update": {
          "opacity": {"signal": "stage >= 3 ? 1 : 0"}
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 1000000000, "offset": -7},
          "x2": {"scale": "x", "value": 1000000000, "offset": 7},
          "y": {"scale": "y", "value": 1000000000},
          "y2": {"scale": "y", "value": 1000000000},
          "stroke": {"value": "#64748b"},
          "strokeWidth": {"value": 2.5}
        },
        "update": {
          "opacity": {"signal": "stage >= 3 ? 1 : 0"}
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 1000000000, "offset": -7},
          "x2": {"scale": "x", "value": 1000000000, "offset": 7},
          "y": {"scale": "y", "value": 5350},
          "y2": {"scale": "y", "value": 5350},
          "stroke": {"value": "#64748b"},
          "strokeWidth": {"value": 2.5}
        },
        "update": {
          "opacity": {"signal": "stage >= 3 ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"scale": "x", "value": 1000000000, "offset": -18},
          "y": {"scale": "y", "value": 735000},
          "align": {"value": "right"},
          "baseline": {"value": "middle"},
          "lineHeight": {"value": 21},
          "text": {"value": ["> 5 orders of magnitude", "fewer comparisons"]},
          "fill": {"value": "#1a1f4d"},
          "fontWeight": {"value": 700}
        },
        "update": {
          "opacity": {"signal": "stage >= 3 ? 1 : 0"}
        }
      }
    }
  ]
}
