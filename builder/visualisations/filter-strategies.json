    },

    {
      "type": "text",
      "from": {"data": "labels"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "tx", "offset": {"field": "tdx"}},
          "y": {"scale": "y", "field": "y", "offset": {"field": "tdy"}},
          "text": {"field": "tag"},
          "align": {"field": "talign"},
          "fontSize": {"value": 17},
          "fontWeight": {"value": "bold"},
          "fill": {"signal": "datum.tag === 'automatic' ? '#1f6f3f' : '#7b5ea7'"},
          "opacity": {"signal": "stage >= datum.s ? 1 : 0"}
        }
      }
    },

    {
      "type": "rule",
      "from": {"data": "edges"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "x1"}, "y": {"scale": "y", "field": "y1"},
          "x2": {"scale": "x", "field": "x2"}, "y2": {"scale": "y", "field": "y2"},
          "stroke": {"signal": "datum.s === 2 ? '#8a93a6' : '#1f6f3f'"},
          "strokeWidth": {"signal": "datum.s === 2 ? 1.5 : 4"},
          "strokeDash": {"signal": "datum.dash ? [7, 6] : []"},
          "opacity": {"signal": "stage >= datum.s ? 1 : 0"}
        }
      }
    },

    {
      "type": "text",
      "from": {"data": "arrows"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "x"}, "y": {"scale": "y", "field": "y"},
          "text": {"value": "›"},
          "align": {"value": "center"}, "baseline": {"value": "middle"},
          "fontSize": {"value": 40},
          "fill": {"value": "#8a93a6"},
          "opacity": {"signal": "stage >= 3 ? 1 : 0"}
        }
      }
    },

    {
      "type": "symbol",
      "from": {"data": "nodes"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "x"}, "y": {"scale": "y", "field": "y"},
          "size": {"signal": "datum.k === 'match' ? 560 : 340"},
          "fill": {"signal": "datum.k === 'match' ? '#54a24b' : datum.k === 'keep' ? '#9ec5e8' : '#b8bec9'"},
          "stroke": {"signal": "datum.k === 'match' ? '#2f7d2f' : '#3a4660'"},
          "strokeWidth": {"signal": "datum.k === 'match' ? 3 : 1"},
          "opacity": {"signal": "stage < datum.s ? 0 : datum.k === 'drop' ? 0.3 : 1"}
        }
      }
    },

    {
      "type": "symbol",
      "from": {"data": "queries"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "x"}, "y": {"scale": "y", "field": "y"},
          "shape": {"value": "M0,-1 L0.225,-0.309 L0.951,-0.309 L0.363,0.118 L0.588,0.809 L0,0.382 L-0.588,0.809 L-0.363,0.118 L-0.951,-0.309 L-0.225,-0.309 Z"},
          "size": {"value": 520},
          "fill": {"value": "#e45756"},
          "stroke": {"value": "#a02020"},
          "strokeWidth": {"value": 1},
          "opacity": {"signal": "stage >= datum.s ? 1 : 0"}
        }
      }
    },

