    {"name": "y", "type": "linear", "domain": [0, 100], "range": {"signal": "[height - 56, 6]"}, "zero": false}
  ],

  "marks": [
    {
      "type": "rect",
      "from": {"data": "regions"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "x1"}, "x2": {"scale": "x", "field": "x2"},
          "y": {"scale": "y", "field": "y2"}, "y2": {"scale": "y", "field": "y1"},
          "fill": {"field": "fill"},
          "fillOpacity": {"signal": "stage >= datum.s ? 0.09 : 0"},
          "stroke": {"value": "#c3cad6"},
          "strokeWidth": {"value": 1.5},
          "cornerRadius": {"value": 10}
        }
      }
    },

    {
      "type": "text",
      "from": {"data": "labels"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "x", "offset": 6},
          "y": {"scale": "y", "field": "y", "offset": 34},
          "text": {"field": "title"},
          "fontSize": {"value": 26},
          "fontWeight": {"value": "bold"},
          "opacity": {"signal": "stage >= datum.s ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "labels"},
