          "x": {"scale": "x", "signal": "split"}, "y": {"signal": "height - 36"}, "y2": {"signal": "height - 24"},
          "stroke": {"value": "#3a4660"}, "strokeWidth": {"value": 2}
        }
      }
    },
    {
