{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IVF intuition: pick a query point, see which nprobe cells it searches.",
  "width": 1200,
  "height": 640,
  "padding": 0,
  "background": "transparent",
  "signals": [
    { "name": "nlist", "value": 24, "bind": { "input": "range", "min": 8, "max": 64, "step": 8, "name": "nlist " } },
    { "name": "stage", "value": 2, "bind": { "input": "range", "min": 1, "max": 16, "step": 1, "name": "nprobe " } },
    { "name": "nprobe", "update": "stage" },
    { "name": "k", "value": 10, "bind": { "input": "range", "min": 1, "max": 20, "step": 1, "name": "k " } },
    { "name": "probed_cells", "update": "min(nprobe, nlist)" },
    { "name": "interactive", "value": true, "on": [{"events": "click", "update": "!interactive" }] },
    { "name": "qx", "value": 6, "on": [ { "events": "*:pointerover", "update": "interactive ? invert('xscale', x()) : qx" } ] },
    { "name": "qy", "value": 5, "on": [ { "events": "*:pointerover", "update": "interactive ? invert('yscale', y()) : qy" } ] },
    { "name": "scanned", "update": "length(data('scanned_points'))" },
    { "name": "skipped", "update": "500 - scanned" },
    { "name": "found", "update": "length(data('topk_found'))" },
    { "name": "recall", "update": "k > 0 ? found / k : 1" }
  ],
  "data": [
    {
      "name": "centroids",
      "transform": [
        { "type": "sequence", "start": 0, "stop": {"signal": "nlist"}, "as": "id" },
        { "type": "formula", "as": "cols", "expr": "ceil(sqrt(nlist))" },
        { "type": "formula", "as": "rows", "expr": "ceil(nlist / datum.cols)" },
        { "type": "formula", "as": "row", "expr": "floor(datum.id / datum.cols)" },
        { "type": "formula", "as": "col", "expr": "datum.id - datum.row * datum.cols" },
        { "type": "formula", "as": "jx", "expr": "(sin(datum.id * 12.9898) * 43758.5453) - floor(sin(datum.id * 12.9898) * 43758.5453)" },
        { "type": "formula", "as": "jy", "expr": "(sin(datum.id * 78.233) * 12345.6789) - floor(sin(datum.id * 78.233) * 12345.6789)" },
        { "type": "formula", "as": "x", "expr": "((datum.col + 0.15 + 0.7 * datum.jx) / datum.cols) * 10" },
        { "type": "formula", "as": "y", "expr": "((datum.row + 0.15 + 0.7 * datum.jy) / datum.rows) * 10" }
      ]
    },
    {
      "name": "centroids_with_dist",
      "source": "centroids",
      "transform": [
        { "type": "formula", "as": "dist", "expr": "sqrt(pow(datum.x - qx, 2) + pow(datum.y - qy, 2))" },
        { "type": "formula", "as": "pdist", "expr": "sqrt(pow((datum.x - qx) * width / 10, 2) + pow((datum.y - qy) * height / 10, 2))" },
        { "type": "window", "ops": ["row_number"], "as": ["rank"], "sort": { "field": "pdist" } },
        { "type": "formula", "as": "probed", "expr": "datum.rank <= nprobe" },
        { "type": "formula", "as": "px", "expr": "scale('xscale', datum.x)" },
        { "type": "formula", "as": "py", "expr": "scale('yscale', datum.y)" }
      ]
    },
    {
      "name": "voronoi",
      "source": "centroids_with_dist",
      "transform": [
        { "type": "voronoi", "x": "px", "y": "py", "size": [ {"signal": "width"}, {"signal": "height"} ] }
      ]
    },
    {
      "name": "background_points",
      "transform": [
        { "type": "sequence", "start": 0, "stop": 500, "as": "i" },
        { "type": "formula", "as": "hx", "expr": "(sin(datum.i * 91.345 + 3.1) * 47453.5453) - floor(sin(datum.i * 91.345 + 3.1) * 47453.5453)" },
        { "type": "formula", "as": "hy", "expr": "(sin(datum.i * 27.719 + 1.7) * 23421.6311) - floor(sin(datum.i * 27.719 + 1.7) * 23421.6311)" },
        { "type": "formula", "as": "x", "expr": "datum.hx * 10" },
        { "type": "formula", "as": "y", "expr": "datum.hy * 10" }
      ]
    },
    {
      "name": "point_centroid_pairs",
      "source": "background_points",
      "transform": [
        { "type": "formula", "as": "cids", "expr": "sequence(0, nlist)" },
        { "type": "flatten", "fields": ["cids"], "as": ["cid"] },
        { "type": "lookup", "from": "centroids", "key": "id", "fields": ["cid"], "values": ["x", "y"], "as": ["cx", "cy"] },
        { "type": "formula", "as": "cd", "expr": "pow((datum.x - datum.cx) * width / 10, 2) + pow((datum.y - datum.cy) * height / 10, 2)" },
        { "type": "aggregate", "groupby": ["i", "x", "y"], "ops": ["argmin"], "fields": ["cd"], "as": ["nearest"] },
        { "type": "formula", "as": "cell", "expr": "datum.nearest.cid" }
      ]
    },
    {
      "name": "points_ranked",
      "source": "point_centroid_pairs",
      "transform": [
        { "type": "formula", "as": "qdist", "expr": "sqrt(pow((datum.x - qx) * width / 10, 2) + pow((datum.y - qy) * height / 10, 2))" },
        { "type": "lookup", "from": "centroids_with_dist", "key": "id", "fields": ["cell"], "values": ["probed"], "as": ["probed"] },
        { "type": "window", "ops": ["row_number"], "as": ["qrank"], "sort": { "field": "qdist" } },
        { "type": "formula", "as": "topk", "expr": "datum.qrank <= k" }
      ]
    },
    { "name": "scanned_points", "source": "points_ranked", "transform": [ { "type": "filter", "expr": "datum.probed" } ] },
    { "name": "topk_found", "source": "points_ranked", "transform": [ { "type": "filter", "expr": "datum.topk && datum.probed" } ] },
    { "name": "topk_missed", "source": "points_ranked", "transform": [ { "type": "filter", "expr": "datum.topk && !datum.probed" } ] },
    {
      "name": "query",
      "values": [ {"x": 5, "y": 5} ],
      "transform": [
        { "type": "formula", "as": "x", "expr": "qx" },
        { "type": "formula", "as": "y", "expr": "qy" }
      ]
    },
    {
      "name": "probed_centroids",
      "source": "centroids_with_dist",
      "transform": [
        { "type": "filter", "expr": "datum.probed" }
      ]
    }
  ],
  "scales": [
    { "name": "xscale", "type": "linear", "domain": [0, 10], "range": "width" },
    { "name": "yscale", "type": "linear", "domain": [0, 10], "range": "height" }
  ],
  "marks": [
    {
      "type": "path",
      "from": { "data": "voronoi" },
      "encode": {
        "enter": { "stroke": { "value": "#bbb" }, "strokeWidth": { "value": 1 } },
        "update": {
          "path": { "field": "path" },
          "fill": [
            { "test": "datum.probed", "value": "#1f6feb" },
            { "value": "#f6f8fa" }
          ],
          "fillOpacity": [
            { "test": "datum.probed", "value": 0.25 },
            { "value": 1 }
          ]
        }
      }
    },
    {
      "type": "symbol",
      "from": { "data": "background_points" },
      "encode": {
        "enter": {
          "shape": { "value": "circle" },
          "size": { "value": 12 },
          "fill": { "value": "#6b7280" },
          "fillOpacity": { "value": 0.45 }
        },
        "update": {
          "x": { "scale": "xscale", "field": "x" },
          "y": { "scale": "yscale", "field": "y" }
        }
      }
    },
    {
      "type": "rule",
      "from": { "data": "topk_missed" },
      "encode": {
        "enter": { "stroke": { "value": "#c84cff" }, "strokeWidth": { "value": 1.5 }, "strokeDash": { "value": [2, 4] }, "strokeOpacity": { "value": 0.7 } },
        "update": {
          "x": { "scale": "xscale", "signal": "qx" }, "y": { "scale": "yscale", "signal": "qy" },
          "x2": { "scale": "xscale", "field": "x" }, "y2": { "scale": "yscale", "field": "y" }
        }
      }
    },
    {
      "type": "symbol",
      "from": { "data": "topk_found" },
      "encode": {
        "enter": { "shape": { "value": "circle" }, "size": { "value": 170 }, "fill": { "value": "#175fff" }, "stroke": { "value": "#ffffff" }, "strokeWidth": { "value": 2 } },
        "update": { "x": { "scale": "xscale", "field": "x" }, "y": { "scale": "yscale", "field": "y" } }
      }
    },
    {
      "type": "symbol",
      "from": { "data": "topk_missed" },
      "encode": {
        "enter": { "shape": { "value": "circle" }, "size": { "value": 260 }, "fill": { "value": "#ffffff" }, "stroke": { "value": "#c84cff" }, "strokeWidth": { "value": 4 } },
        "update": { "x": { "scale": "xscale", "field": "x" }, "y": { "scale": "yscale", "field": "y" } }
      }
    },
    {
      "type": "rule",
      "from": { "data": "probed_centroids" },
      "encode": {
        "enter": {
          "stroke": { "value": "#c84cff" },
          "strokeWidth": { "value": 1.5 },
          "strokeDash": { "value": [4, 4] },
          "strokeOpacity": { "value": 0.85 }
        },
        "update": {
          "x": { "scale": "xscale", "signal": "qx" },
          "y": { "scale": "yscale", "signal": "qy" },
          "x2": { "field": "px" },
          "y2": { "field": "py" }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "probed_centroids" },
      "encode": {
        "enter": {
          "fill": { "value": "#0a2540" },
          "fontSize": { "value": 11 },
          "fontWeight": { "value": "bold" },
          "align": { "value": "center" },
          "baseline": { "value": "middle" }
        },
        "update": {
          "x": { "signal": "(scale('xscale', qx) + datum.px) / 2" },
          "y": { "signal": "(scale('yscale', qy) + datum.py) / 2 - 8" },
          "text": { "signal": "format(datum.dist, '.2f')" }
        }
      }
    },
    {
      "type": "symbol",
      "from": { "data": "centroids_with_dist" },
      "encode": {
        "enter": { "size": { "value": 60 }, "shape": { "value": "circle" } },
        "update": {
          "x": { "field": "px" },
          "y": { "field": "py" },
          "fill": [
            { "test": "datum.probed", "value": "#0a2540" },
            { "value": "#9aa4b2" }
          ]
        }
      }
    },
    {
      "type": "symbol",
      "from": { "data": "query" },
      "encode": {
        "enter": { "size": { "value": 220 }, "shape": { "value": "diamond" }, "fill": { "value": "#c84cff" }, "stroke": { "value": "#fff" }, "strokeWidth": { "value": 2 } },
        "update": {
          "x": { "scale": "xscale", "field": "x" },
          "y": { "scale": "yscale", "field": "y" }
        }
      }
    },    {
      "type": "rect",
      "encode": {
        "enter": {
          "fill": { "value": "#ffffff" },
          "fillOpacity": { "value": 0.94 },
          "stroke": { "value": "#d1d5db" },
          "strokeWidth": { "value": 1 },
          "cornerRadius": { "value": 8 }
        },
        "update": {
          "x": { "value": 14 },
          "y": { "value": 14 },
          "width": { "value": 700 },
          "height": { "value": 96 }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "fontWeight": { "value": "bold" },
          "fill": { "value": "#0a2540" },
          "align": { "value": "left" },
          "baseline": { "value": "top" }
        },
        "update": {
          "x": { "value": 26 },
          "y": { "value": 26 },
          "text": { "signal": "'Compared ' + scanned + ' / 500 vectors  •  Skipped ' + skipped + '  (' + format(skipped / 500, '.0%') + ' of dataset)'" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "fill": { "value": "#475569" },
          "align": { "value": "left" },
          "baseline": { "value": "top" }
        },
        "update": {
          "x": { "value": 26 },
          "y": { "value": 50 },
          "text": { "signal": "'nprobe = ' + probed_cells + ' of ' + nlist + ' cells visited, the rest of the index is never touched.'" }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": { "fontWeight": { "value": "bold" }, "align": { "value": "left" }, "baseline": { "value": "top" } },
        "update": {
          "x": { "value": 26 }, "y": { "value": 74 },
          "fill": [ { "test": "found == k", "value": "#061982" }, { "value": "#c84cff" } ],
          "text": { "signal": "'recall@' + k + ' = ' + (recall == 1 ? '1.0' : format(recall, '.2~f')) + (found < k ? '  •  ' + (k - found) + (k - found == 1 ? ' true neighbour sits' : ' true neighbours sit') + ' in cells we never opened' : '  •  every true neighbour found')" }
        }
      }
    }
  ]
}