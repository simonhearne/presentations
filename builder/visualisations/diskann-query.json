        {"type": "formula", "as": "isCurrent", "expr": "datum.id === current"},
        {"type": "formula", "as": "isNbr", "expr": "stage >= 2 && !done && indexof(nbrs, datum.id) >= 0 && !datum.isRead"}
      ]
    },
