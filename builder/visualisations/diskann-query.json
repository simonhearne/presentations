{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "DiskANN query: greedy walk over a Vamana graph, each hop one SSD block read, neighbours scored from PQ codes held in RAM.",
  "width": 1200,
  "height": 600,
  "padding": 0,
  "autosize": "fit",

  "signals": [
    {"name": "stage", "value": 0},
    {"name": "path", "value": ["M", "n56", "n44", "n11", "n28"]},
    {"name": "flatReads", "value": 60},
    {
      "name": "hop", "value": 0,
      "on": [{"events": {"type": "timer", "throttle": 1100}, "update": "stage < 2 ? 0 : min(hop + 1, length(path))"}]
    },
    {"name": "current", "update": "hop > 0 ? path[hop - 1] : ''"},
    {"name": "done", "update": "hop === length(path)"},
    {"name": "nbrs", "update": "pluck(data('nbrEdges'), 'other')"},
    {
      "name": "narration",
      "update": "stage === 0 ? 'The graph and full vectors live on SSD, one block per vector. RAM holds only compressed PQ codes.' : stage === 1 ? 'A query arrives. Every search starts at the same entry point, the medoid.' : done ? 'Converged: ' + hop + ' SSD reads to find the nearest neighbour. A flat scan reads all ' + flatReads + '.' : 'Each hop reads one block from SSD, then scores its neighbours using PQ codes in RAM.'"
    },
    {"name": "gx0", "value": 10},
    {"name": "gx1", "value": 590},
    {"name": "mx", "value": 660},
    {"name": "ramY", "value": 110},
    {"name": "ssdY", "value": 250}
  ],

  "data": [
