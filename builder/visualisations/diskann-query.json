        {"type": "formula", "as": "y1", "expr": "datum.pa.y"},
        {"type": "formula", "as": "x2", "expr": "datum.pb.x"},
        {"type": "formula", "as": "y2", "expr": "datum.pb.y"}
      ]
    },
    {
      "name": "nbrEdges",
      "source": "edges",
      "transform": [
        {"type": "filter", "expr": "datum.a === current || datum.b === current"},
        {"type": "formula", "as": "other", "expr": "datum.a === current ? datum.b : datum.a"}
      ]
    },
    {
      "name": "pathEdges",
      "source": "edges",
      "transform": [
        {"type": "formula", "as": "ia", "expr": "indexof(path, datum.a)"},
        {"type": "formula", "as": "ib", "expr": "indexof(path, datum.b)"},
        {"type": "filter", "expr": "datum.ia >= 0 && datum.ib >= 0 && abs(datum.ia - datum.ib) === 1"},
        {"type": "formula", "as": "order", "expr": "max(datum.ia, datum.ib)"}
      ]
    },
    {
      "name": "query",
      "values": [{"x": 7.7, "y": 2.2}]
    }
  ],

  "scales": [
    {"name": "xscale", "type": "linear", "domain": [0, 10], "range": {"signal": "[gx0 + 10, gx1 - 10]"}},
    {"name": "yscale", "type": "linear", "domain": [0, 10], "range": {"signal": "[height - 20, 70]"}}
  ],

  "marks": [
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 0}, "y": {"value": 16},
          "text": {"signal": "narration"},
          "fontSize": {"value": 22}, "fontWeight": {"value": 600},
          "limit": {"signal": "width"}
        }
      }
    },

    {
      "type": "rule",
      "from": {"data": "edges"},
      "encode": {
        "update": {
          "x": {"scale": "xscale", "field": "x1"}, "y": {"scale": "yscale", "field": "y1"},
          "x2": {"scale": "xscale", "field": "x2"}, "y2": {"scale": "yscale", "field": "y2"},
          "stroke": {"signal": "datum.long ? '#c84cff' : '#cbd5e1'"},
          "strokeWidth": {"signal": "datum.long ? 1.4 : 1"},
          "opacity": {"signal": "(datum.long ? 0.55 : 1) * (stage >= 2 ? 0.6 : 1)"}
        }
      }
    },
    {
      "type": "rule",
      "from": {"data": "nbrEdges"},
      "encode": {
        "update": {
          "x": {"scale": "xscale", "field": "x1"}, "y": {"scale": "yscale", "field": "y1"},
          "x2": {"scale": "xscale", "field": "x2"}, "y2": {"scale": "yscale", "field": "y2"},
          "stroke": {"value": "#c84cff"}, "strokeWidth": {"value": 2}, "strokeDash": {"value": [5, 4]},
          "opacity": {"signal": "stage >= 2 && !done ? 1 : 0"}
        }
      }
    },
    {
      "type": "rule",
      "from": {"data": "pathEdges"},
      "encode": {
        "update": {
          "x": {"scale": "xscale", "field": "x1"}, "y": {"scale": "yscale", "field": "y1"},
          "x2": {"scale": "xscale", "field": "x2"}, "y2": {"scale": "yscale", "field": "y2"},
          "stroke": {"value": "#175fff"}, "strokeWidth": {"value": 4}, "strokeCap": {"value": "round"},
          "opacity": {"signal": "hop > datum.order ? 1 : 0"}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "points"},
      "encode": {
        "update": {
          "x": {"scale": "xscale", "field": "x"}, "y": {"scale": "yscale", "field": "y"},
          "shape": {"signal": "datum.id === 'M' ? 'diamond' : 'circle'"},
          "size": {"signal": "datum.id === 'M' ? 320 : datum.isRead ? 420 : datum.isNbr ? 170 : 70"},
          "fill": {"signal": "datum.isRead ? '#175fff' : datum.id === 'M' ? '#c84cff' : '#6b7280'"},
          "stroke": {"signal": "datum.isCurrent ? '#061982' : datum.isNbr ? '#c84cff' : '#ffffff'"},
          "strokeWidth": {"signal": "datum.isCurrent || datum.isNbr ? 3 : 1"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "points"},
      "encode": {
        "update": {
          "x": {"scale": "xscale", "field": "x"}, "y": {"scale": "yscale", "field": "y"},
          "text": {"signal": "datum.isRead ? '' + datum.readOrder : ''"},
          "align": {"value": "center"}, "baseline": {"value": "middle"},
          "fontSize": {"value": 14}, "fontWeight": {"value": "bold"}, "fill": {"value": "#ffffff"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"scale": "xscale", "value": 5}, "y": {"scale": "yscale", "value": 5, "offset": -18},
          "text": {"value": "entry (medoid)"},
          "align": {"value": "center"}, "fontSize": {"value": 16}, "fill": {"value": "#c84cff"}, "fontWeight": {"value": 600},
          "opacity": {"signal": "stage >= 1 ? 1 : 0"}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "query"},
      "encode": {
        "update": {
          "x": {"scale": "xscale", "field": "x"}, "y": {"scale": "yscale", "field": "y"},
          "shape": {"value": "M0,-1 L0.225,-0.309 L0.951,-0.309 L0.363,0.118 L0.588,0.809 L0,0.382 L-0.588,0.809 L-0.363,0.118 L-0.951,-0.309 L-0.225,-0.309 Z"},
          "size": {"value": 800}, "fill": {"value": "#f59e0b"}, "stroke": {"value": "#ffffff"}, "strokeWidth": {"value": 1.5},
          "opacity": {"signal": "stage >= 1 ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "query"},
      "encode": {
        "update": {
          "x": {"scale": "xscale", "field": "x", "offset": 14}, "y": {"scale": "yscale", "field": "y", "offset": -16},
          "text": {"value": "query"},
          "align": {"value": "left"}, "fontSize": {"value": 16}, "fill": {"value": "#b45309"}, "fontWeight": {"value": 600},
          "opacity": {"signal": "stage >= 1 ? 1 : 0"}
        }
      }
    },

    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "mx"}, "y": {"signal": "ramY - 14"},
          "text": {"value": "RAM: PQ codes, ~32 bytes per vector"},
          "fontSize": {"value": 18}, "fontWeight": {"value": "bold"}
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {"signal": "mx"}, "y": {"signal": "ramY"}, "x2": {"signal": "width"}, "height": {"value": 66},
          "fill": {"value": "#f8fafc"}, "stroke": {"value": "#cbd5e1"}, "cornerRadius": {"value": 6}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "points"},
      "encode": {
        "update": {
          "x": {"signal": "mx + 12 + (datum.idx % 30) * 17.4"}, "width": {"value": 13},
          "y": {"signal": "ramY + 12 + floor(datum.idx / 30) * 22"}, "height": {"value": 16},
          "fill": {"signal": "datum.isNbr ? '#c84cff' : '#c7d2fe'"},
          "cornerRadius": {"value": 2}
        }
      }
    },

    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "mx"}, "y": {"signal": "ssdY - 14"},
          "text": {"value": "SSD: one block per vector (full vector + neighbour IDs)"},
          "fontSize": {"value": 18}, "fontWeight": {"value": "bold"}
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {"signal": "mx"}, "y": {"signal": "ssdY"}, "x2": {"signal": "width"}, "height": {"value": 258},
          "fill": {"value": "#f8fafc"}, "stroke": {"value": "#cbd5e1"}, "cornerRadius": {"value": 6}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "points"},
      "encode": {
        "update": {
          "x": {"signal": "mx + 12 + (datum.idx % 10) * 52.5"}, "width": {"value": 46},
          "y": {"signal": "ssdY + 12 + floor(datum.idx / 10) * 40"}, "height": {"value": 34},
          "fill": {"signal": "datum.isRead ? '#175fff' : '#e2e8f0'"},
          "stroke": {"signal": "datum.isCurrent ? '#061982' : '#ffffff'"},
          "strokeWidth": {"signal": "datum.isCurrent ? 3 : 1"},
          "cornerRadius": {"value": 3}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "points"},
      "encode": {
        "update": {
          "x": {"signal": "mx + 12 + (datum.idx % 10) * 52.5 + 23"},
          "y": {"signal": "ssdY + 12 + floor(datum.idx / 10) * 40 + 17"},
          "text": {"signal": "datum.isRead ? '' + datum.readOrder : ''"},
          "align": {"value": "center"}, "baseline": {"value": "middle"},
          "fontSize": {"value": 16}, "fontWeight": {"value": "bold"}, "fill": {"value": "#ffffff"}
        }
      }
    },

    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "mx"}, "y": {"signal": "ssdY + 300"},
          "text": {"signal": "'SSD reads: ' + hop"},
          "fontSize": {"value": 34}, "fontWeight": {"value": "bold"}, "fill": {"value": "#175fff"},
          "opacity": {"signal": "stage >= 2 ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "width"}, "y": {"signal": "ssdY + 300"},
          "text": {"signal": "'flat scan: ' + flatReads + ' reads'"},
          "align": {"value": "right"},
          "fontSize": {"value": 26}, "fill": {"value": "#64748b"},
          "opacity": {"signal": "done ? 1 : 0"}
        }
      }
    }
  ]
}
