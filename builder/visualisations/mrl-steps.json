{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Stepped walkthrough of Matryoshka representation learning as a vertical vector column: a full vector whose per-dimension importance is in no particular order -> the rows re-ordered so importance runs high to low -> slice off a prefix and drop the tail -> a shorter, complete output vector. Stepped via the stage signal.",
  "width": 820,
  "height": 500,
  "padding": 5,
  "signals": [
    {"name": "stage", "value": 0},
    {"name": "colX", "value": 150},
    {"name": "curveX", "value": 262},
    {"name": "curveW", "value": 84},
    {"name": "outX", "value": 600},
    {"name": "stripY", "value": 104},
    {"name": "cellW", "value": 54},
    {"name": "cellH", "value": 13},
    {"name": "n", "value": 24},
    {"name": "prefixN", "value": 8},
    {"name": "cutY", "update": "stripY + prefixN * cellH"},
    {"name": "midPrefixY", "update": "stripY + prefixN * cellH / 2"},
    {
      "name": "sortT",
      "value": 0,
      "on": [
        {
          "events": {"type": "timer", "throttle": 16},
          "update": "stage >= 1 ? min(1, sortT + 0.025) : 0"
        }
      ]
    },
    {"name": "sortE", "update": "sortT * sortT * (3 - 2 * sortT)"},
    {
      "name": "headline",
      "value": "3072 dimensions, no order",
      "on": [
        {
          "events": {"signal": "stage"},
          "update": "['3072 dimensions, no order', 'importance first', 'keep the first 256', 'one shorter, complete vector'][stage]"
        }
      ]
    },
    {
      "name": "narration",
      "value": "One vector. Normally the important dimensions are scattered throughout.",
      "on": [
        {
          "events": {"signal": "stage"},
          "update": "['One vector. Normally the important dimensions are scattered throughout.', 'MRL training puts the most informative dimensions first: the tail adds diminishing detail.', 'Slice off a prefix and discard the rest: no re-embedding, no second model.', 'The prefix is itself a valid, normalised vector: 12× smaller, ranks almost as well. (cells shown for clarity)'][stage]"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "cells",
      "values": [
        {"i": 0}, {"i": 1}, {"i": 2}, {"i": 3}, {"i": 4}, {"i": 5},
        {"i": 6}, {"i": 7}, {"i": 8}, {"i": 9}, {"i": 10}, {"i": 11},
        {"i": 12}, {"i": 13}, {"i": 14}, {"i": 15}, {"i": 16}, {"i": 17},
        {"i": 18}, {"i": 19}, {"i": 20}, {"i": 21}, {"i": 22}, {"i": 23}
      ],
      "transform": [
        {"type": "formula", "expr": "pow(0.9, datum.i)", "as": "imp"},
        {"type": "formula", "expr": "[13, 4, 19, 8, 22, 1, 16, 10, 6, 20, 3, 14, 0, 18, 9, 23, 5, 12, 21, 2, 17, 7, 15, 11][datum.i]", "as": "pos"},
        {"type": "formula", "expr": "[0.62, 0.18, 0.85, 0.4, 0.27, 0.93, 0.55, 0.12, 0.71, 0.35, 0.88, 0.22, 0.48, 0.79, 0.3, 0.66, 0.15, 0.97, 0.44, 0.58, 0.25, 0.82, 0.37, 0.69][datum.i]", "as": "val"},
        {"type": "formula", "expr": "datum.pos + (datum.i - datum.pos) * sortE", "as": "row"}
      ]
    }
  ],
  "scales": [
    {
      "name": "heat",
      "type": "linear",
      "domain": [0, 1],
      "range": ["#e6f0ff", "#49bcff", "#175fff", "#061982"]
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "(colX + outX + cellW) / 2"},
          "y": {"value": 50},
          "text": {"signal": "headline"},
          "align": {"value": "center"}, "baseline": {"value": "alphabetic"},
          "fontSize": {"value": 21}, "fontWeight": {"value": "bold"},
          "fill": {"value": "#1e293b"}
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "(colX + outX + cellW) / 2"},
          "y": {"value": 70},
          "text": {"value": "3072-D  →  256-D   ·   12× smaller"},
          "align": {"value": "center"}, "baseline": {"value": "alphabetic"},
          "fontSize": {"value": 18}, "fontWeight": {"value": "bold"},
          "fill": {"value": "#175fff"},
          "opacity": [{"test": "stage >= 3", "value": 1}, {"value": 0}]
        }
      }
    },

    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "colX + cellW / 2"},
          "y": {"signal": "stripY - 12"},
          "text": {"value": "the vector · 3072-D"},
          "align": {"value": "center"}, "baseline": {"value": "alphabetic"},
          "fontSize": {"value": 13}, "fontWeight": {"value": "bold"},
          "fill": {"value": "#64748b"}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "cells"},
      "encode": {
        "update": {
          "x": {"signal": "colX"},
          "width": {"signal": "cellW"},
          "y": {"signal": "stripY + datum.row * cellH"},
          "height": {"signal": "cellH - 1.5"},
          "fill": {"scale": "heat", "field": "val"},
          "cornerRadius": {"value": 1.5},
          "opacity": [{"test": "stage >= 2 && datum.i >= prefixN", "value": 0.18}, {"value": 1}]
        }
      }
    },

    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "curveX"},
          "y": {"signal": "stripY - 12"},
          "text": {"value": "importance →"},
          "align": {"value": "left"}, "baseline": {"value": "alphabetic"},
          "fontSize": {"value": 13}, "fontWeight": {"value": "bold"},
          "fill": {"value": "#64748b"}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "cells"},
      "encode": {
        "update": {
          "x": {"signal": "curveX"},
          "width": {"signal": "max(2, datum.imp * curveW)"},
          "y": {"signal": "stripY + datum.row * cellH"},
          "height": {"signal": "cellH - 2.5"},
          "fill": {"value": "#7c3aed"},
          "cornerRadius": {"value": 1},
          "opacity": [
            {"test": "stage >= 2 && datum.i >= prefixN", "value": 0.16},
            {"value": 0.85}
          ]
        }
      }
    },

    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {"signal": "colX - 12"}, "x2": {"signal": "curveX + curveW + 8"},
          "y": {"signal": "cutY"}, "y2": {"signal": "cutY"},
          "stroke": {"value": "#16a34a"}, "strokeWidth": {"value": 2},
          "strokeDash": {"value": [5, 4]},
          "opacity": [{"test": "stage >= 2", "value": 1}, {"value": 0}]
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "curveX + curveW + 16"},
          "y": {"signal": "midPrefixY - 6"},
          "text": {"value": "keep · 256-D"},
          "align": {"value": "left"}, "baseline": {"value": "middle"},
          "fontSize": {"value": 13}, "fontWeight": {"value": "bold"},
          "fill": {"value": "#16a34a"},
          "opacity": [{"test": "stage >= 2", "value": 1}, {"value": 0}]
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "curveX + curveW + 16"},
          "y": {"signal": "cutY + 22"},
          "text": {"value": "drop · 2816-D"},
          "align": {"value": "left"}, "baseline": {"value": "middle"},
          "fontSize": {"value": 13}, "fontWeight": {"value": "bold"},
          "fill": {"value": "#94a3b8"},
          "opacity": [{"test": "stage >= 2", "value": 1}, {"value": 0}]
        }
      }
    },

    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {"signal": "curveX + curveW + 120"}, "x2": {"signal": "outX - 26"},
          "y": {"signal": "midPrefixY"}, "y2": {"signal": "midPrefixY"},
          "stroke": {"value": "#94a3b8"}, "strokeWidth": {"value": 2},
          "opacity": [{"test": "stage >= 3", "value": 1}, {"value": 0}]
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "update": {
          "x": {"signal": "outX - 26"}, "y": {"signal": "midPrefixY"},
          "shape": {"value": "triangle-right"}, "size": {"value": 100},
          "fill": {"value": "#94a3b8"},
          "opacity": [{"test": "stage >= 3", "value": 1}, {"value": 0}]
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "outX + cellW / 2"},
          "y": {"signal": "stripY - 12"},
          "text": {"value": "256-D prefix"},
          "align": {"value": "center"}, "baseline": {"value": "alphabetic"},
          "fontSize": {"value": 13}, "fontWeight": {"value": "bold"},
          "fill": {"value": "#175fff"},
          "opacity": [{"test": "stage >= 3", "value": 1}, {"value": 0}]
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "cells"},
      "encode": {
        "update": {
          "x": {"signal": "outX"},
          "width": {"signal": "cellW"},
          "y": {"signal": "stripY + datum.i * cellH"},
          "height": {"signal": "cellH - 1.5"},
          "fill": {"scale": "heat", "field": "val"},
          "cornerRadius": {"value": 1.5},
          "opacity": [{"test": "stage >= 3 && datum.i < prefixN", "value": 1}, {"value": 0}]
        }
      }
    },

    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"signal": "(colX + outX + cellW) / 2"},
          "y": {"value": 476},
          "text": {"signal": "narration"},
          "align": {"value": "center"}, "baseline": {"value": "alphabetic"},
          "fontSize": {"value": 16}, "fill": {"value": "#1e293b"}
        }
      }
    }
  ]
}
